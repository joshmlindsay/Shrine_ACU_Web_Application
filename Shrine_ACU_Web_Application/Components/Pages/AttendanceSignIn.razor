@page "/attendance/sign-in"
@page "/attendance/sign-in/{EventId:int}"
@rendermode InteractiveServer

@inject AttendanceEventsApiClient EventsApi
@inject AttendeesApiClient AttendeesApi
@inject AttendanceRecordsApiClient RecordsApi
@inject DialogService DialogService
@inject IWebHostEnvironment Environment

<PageTitle>Attendance Sign-In</PageTitle>

<RadzenStack Gap="1rem" Style="max-width:860px;margin:0 auto;padding-bottom:1.5rem;">
    <RadzenCard>
        <RadzenStack Gap="0.75rem" AlignItems="AlignItems.Center" Style="text-align:center;">
            <RadzenText TextStyle="TextStyle.H4">Welcome to Attendance</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">Find your name, confirm your profile, then tap the button at the bottom.</RadzenText>

            @if (selectedEvent is not null)
            {
                <RadzenBadge Text="@selectedEvent.Name" BadgeStyle="BadgeStyle.Primary" />
                @if (selectedEvent.EventDates?.Length > 0)
                {
                    <RadzenText TextStyle="TextStyle.Caption">Open on: @string.Join(", ", selectedEvent.EventDates.Where(x => x.EventDate.HasValue).OrderBy(x => x.EventDate).Select(x => x.EventDate!.Value.ToString("MMM d")))</RadzenText>
                }
            }
        </RadzenStack>
    </RadzenCard>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Success">@successMessage</RadzenAlert>
    }

    @if (!EventId.HasValue)
    {
        <RadzenCard>
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Body2">Event URL was not provided. Select an event to continue.</RadzenText>
                <RadzenDropDown TValue="int?"
                                Data="@activeEvents"
                                TextProperty="Name"
                                ValueProperty="EventId"
                                Value="@selectedEventId"
                                ValueChanged="OnEventChanged"
                                Style="width:100%;"
                                Placeholder="Select an event" />
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenTextBox @bind-Value="attendeeLookupText"
                           @oninput="OnAttendeeLookupInput"
                           Placeholder="Type your first or last name"
                           Style="width:100%;font-size:1.1rem;height:52px;" />

            <RadzenDropDown TValue="int?"
                            Data="@attendeeSuggestions"
                            TextProperty="DisplayName"
                            ValueProperty="AttendeeId"
                            Value="@selectedAttendeeId"
                            ValueChanged="OnAttendeeSelected"
                            AllowFiltering="true"
                            AllowClear="true"
                            Placeholder="Select your name"
                            Style="width:100%;" />

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Can't find your name? Sign Up" Icon="person_add" ButtonStyle="ButtonStyle.Light" Click="OpenSignUpAsync" />
                <RadzenButton Text="Clear Selection" Icon="close" ButtonStyle="ButtonStyle.Light" Click="ClearSelection" Disabled="@(selectedAttendeeId is null && string.IsNullOrWhiteSpace(signInModel.FirstName))" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @if (HasProfile)
    {
        <RadzenCard>
            <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center" Style="text-align:center;">
                <RadzenText TextStyle="TextStyle.H5">Confirm Your Info</RadzenText>
                <RadzenText TextStyle="TextStyle.H6">@DisplayName</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">School: @DisplayValue(signInModel.SchoolName)</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">Type: @signInModel.AttendeeType</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenStack AlignItems="AlignItems.Center" Style="padding-top:0.5rem;">
        <RadzenButton Text="I'm Here - Mark Me Present"
                      Icon="check_circle"
                      Size="ButtonSize.Large"
                      ButtonStyle="ButtonStyle.Primary"
                      Disabled="@(!CanSubmit || isSubmitting)"
                      Click="SubmitSignInAsync"
                      Style="min-width:320px;width:100%;max-width:520px;height:58px;font-size:1.1rem;" />
    </RadzenStack>

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H6">Today's Attendance</RadzenText>
            <RadzenDataGrid Data="@todayRecords" TItem="AttendanceRecordDto" EmptyText="No attendance has been marked for today yet.">
                <Columns>
                    <RadzenDataGridColumn TItem="AttendanceRecordDto" Title="Name">
                        <Template Context="record">@FormatAttendeeName(record.Attendee)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AttendanceRecordDto" Title="School">
                        <Template Context="record">@record.Attendee?.SchoolName</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AttendanceRecordDto" Property="DurationHours" Title="Hours" />
                    <RadzenDataGridColumn TItem="AttendanceRecordDto" Title="Checked In">
                        <Template Context="record">@record.AttendanceDate.ToLocalTime().ToString("g")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    [Parameter] public int? EventId { get; set; }

    private readonly List<AttendanceEventDto> activeEvents = [];
    private readonly List<AttendeeSuggestion> attendeeSuggestions = [];
    private readonly List<AttendanceRecordDto> todayRecords = [];

    private readonly AttendanceSignInRequestDto signInModel = new()
    {
        AttendeeType = AttendeeType.Student
    };

    private int? selectedEventId;
    private int? selectedAttendeeId;
    private bool isSubmitting;
    private string? attendeeLookupText;
    private string? errorMessage;
    private string? successMessage;
    private CancellationTokenSource? attendeeLookupCts;

    private AttendanceEventDto? selectedEvent => activeEvents.FirstOrDefault(x => x.EventId == selectedEventId);

    private bool HasProfile => !string.IsNullOrWhiteSpace(signInModel.FirstName) && !string.IsNullOrWhiteSpace(signInModel.LastName);
    private bool CanSubmit => selectedEventId.HasValue && HasProfile && IsTodayAllowedForEvent(selectedEvent);
    private string DisplayName => string.Join(' ', new[] { signInModel.FirstName, signInModel.LastName }.Where(x => !string.IsNullOrWhiteSpace(x))).Trim();

    protected override async Task OnInitializedAsync()
    {
        await LoadEventsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EventId.HasValue && selectedEventId != EventId)
        {
            selectedEventId = EventId;
            signInModel.EventId = EventId.Value;
            await LoadTodayRecordsAsync();
        }
    }

    private async Task LoadEventsAsync()
    {
        try
        {
            errorMessage = null;
            var events = await EventsApi.GetActiveAsync();
            activeEvents.Clear();
            activeEvents.AddRange(events.OrderBy(e => e.EventDate));

            if (selectedEventId is null)
            {
                selectedEventId = EventId ?? activeEvents.FirstOrDefault()?.EventId;
                if (selectedEventId.HasValue)
                {
                    signInModel.EventId = selectedEventId.Value;
                }
            }

            await LoadTodayRecordsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to load active attendance events.", ex);
        }
    }

    private Task OnEventChanged(int? eventId)
    {
        selectedEventId = eventId;
        signInModel.EventId = eventId ?? 0;
        successMessage = null;
        return LoadTodayRecordsAsync();
    }

    private async Task OnAttendeeLookupInput(ChangeEventArgs args)
    {
        attendeeLookupText = args.Value?.ToString();
        await DebounceLookupAsync(attendeeLookupText);
    }

    private async Task DebounceLookupAsync(string? term)
    {
        attendeeLookupCts?.Cancel();
        attendeeLookupCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(250, attendeeLookupCts.Token);
            await SearchAttendeesAsync(term, attendeeLookupCts.Token);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SearchAttendeesAsync(string? term, CancellationToken cancellationToken)
    {
        attendeeSuggestions.Clear();

        if (string.IsNullOrWhiteSpace(term))
        {
            selectedAttendeeId = null;
            return;
        }

        try
        {
            var page = await AttendeesApi.SearchAsync(term.Trim(), 1, 25, cancellationToken);
            attendeeSuggestions.AddRange(page.Items
                .Where(x => x.AttendeeId.HasValue)
                .Select(x => new AttendeeSuggestion(x))
                .OrderBy(x => x.DisplayName));
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to search attendees.", ex);
        }
    }

    private Task OnAttendeeSelected(int? attendeeId)
    {
        selectedAttendeeId = attendeeId;
        var selected = attendeeSuggestions.FirstOrDefault(x => x.AttendeeId == attendeeId);
        if (selected is not null)
        {
            signInModel.FirstName = selected.FirstName;
            signInModel.LastName = selected.LastName;
            signInModel.SchoolName = selected.SchoolName;
            signInModel.AttendeeType = selected.AttendeeType;
        }

        return Task.CompletedTask;
    }

    private async Task OpenSignUpAsync()
    {
        var result = await DialogService.OpenAsync<AttendanceSignUpDialog>(
            "Quick Sign Up",
            new Dictionary<string, object?>
            {
                [nameof(AttendanceSignUpDialog.InitialSearchText)] = attendeeLookupText
            },
            new DialogOptions
            {
                Width = "520px",
                Resizable = false,
                Draggable = false,
                CloseDialogOnOverlayClick = false
            });

        if (result is AttendanceSignInRequestDto dto)
        {
            selectedAttendeeId = null;
            signInModel.FirstName = dto.FirstName;
            signInModel.LastName = dto.LastName;
            signInModel.SchoolName = dto.SchoolName;
            signInModel.AttendeeType = dto.AttendeeType;
            successMessage = "Profile ready. Tap the button below to mark present.";
        }
    }

    private Task ClearSelection()
    {
        selectedAttendeeId = null;
        signInModel.FirstName = null;
        signInModel.LastName = null;
        signInModel.SchoolName = null;
        signInModel.AttendeeType = AttendeeType.Student;
        return Task.CompletedTask;
    }

    private async Task SubmitSignInAsync()
    {
        successMessage = null;
        errorMessage = null;

        if (selectedEventId is null)
        {
            errorMessage = "This page requires a valid attendance event.";
            return;
        }

        var eventModel = activeEvents.FirstOrDefault(x => x.EventId == selectedEventId);
        if (!IsTodayAllowedForEvent(eventModel))
        {
            errorMessage = "This event is not open for attendance today.";
            return;
        }

        if (!HasProfile)
        {
            errorMessage = "Select your name or use Sign Up first.";
            return;
        }

        signInModel.EventId = selectedEventId.Value;
        signInModel.AttendanceDate = DateTime.Today;

        isSubmitting = true;
        try
        {
            var result = await RecordsApi.SignInAsync(signInModel);
            successMessage = $"You're checked in. Thanks, {FormatAttendeeName(result?.Attendee) ?? DisplayName}!";
            await LoadTodayRecordsAsync();
        }
        catch (ApiErrorException ex) when (ex.Error.StatusCode == 409)
        {
            errorMessage = "You are already signed in for this event today.";
        }
        catch (ApiErrorException ex) when (ex.Error.StatusCode == 400)
        {
            errorMessage = ex.Error.Message;
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to complete sign-in.", ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadTodayRecordsAsync()
    {
        todayRecords.Clear();

        if (selectedEventId is null)
        {
            return;
        }

        try
        {
            var result = await RecordsApi.SearchAsync(new AttendanceSearchRequestDto
            {
                EventId = selectedEventId,
                AttendanceDate = DateTime.Today,
                Page = 1,
                PageSize = 100
            });

            todayRecords.AddRange(result.Items.OrderBy(x => x.Attendee?.LastName).ThenBy(x => x.Attendee?.FirstName));
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to load today's attendance list.", ex);
        }
    }

    private string BuildErrorMessage(string message, Exception exception) =>
        Environment.IsDevelopment() ? $"{message} {exception.Message}" : message;

    private static string? FormatAttendeeName(AttendeeDto? attendee)
    {
        if (attendee is null)
        {
            return null;
        }

        return string.Join(' ', new[] { attendee.FirstName, attendee.LastName }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static bool IsTodayAllowedForEvent(AttendanceEventDto? attendanceEvent)
    {
        if (attendanceEvent is null)
        {
            return false;
        }

        if (attendanceEvent.EventDates is null || attendanceEvent.EventDates.Length == 0)
        {
            return true;
        }

        return attendanceEvent.EventDates.Any(x => x.EventDate == DateOnly.FromDateTime(DateTime.Today));
    }

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;

    private sealed record AttendeeSuggestion
    {
        public AttendeeSuggestion(AttendeeDto attendee)
        {
            AttendeeId = attendee.AttendeeId;
            FirstName = attendee.FirstName;
            LastName = attendee.LastName;
            SchoolName = attendee.SchoolName;
            AttendeeType = attendee.AttendeeType;
            DisplayName = string.IsNullOrWhiteSpace(SchoolName)
                ? $"{FirstName} {LastName}".Trim()
                : $"{FirstName} {LastName}".Trim() + $" ({SchoolName})";
        }

        public int? AttendeeId { get; }
        public string? FirstName { get; }
        public string? LastName { get; }
        public string? SchoolName { get; }
        public AttendeeType AttendeeType { get; }
        public string DisplayName { get; }
    }
}
