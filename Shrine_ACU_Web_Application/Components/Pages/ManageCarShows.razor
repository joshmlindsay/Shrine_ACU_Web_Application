@page "/manage-carshows"
@rendermode InteractiveServer
@inject AcuCarShowClient Client
@inject NavigationManager Navigation
@inject UserSessionService UserSession

<PageTitle>Manage Car Shows</PageTitle>

@if (!UserSession.IsAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">You must log in before managing car shows.</RadzenAlert>
}
else if (!UserSession.CanManageUsers)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">Only administrators can create car shows.</RadzenAlert>
}
else
{
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H4">Manage Car Shows</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption">New events are active immediately. Select a prior show to copy its reusable configuration.</RadzenText>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
        }

        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Event name" Variant="Variant.Outlined" Style="width:100%;">
                            <RadzenTextBox @bind-Value="eventName" Style="width:100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Copy configuration from" Variant="Variant.Outlined" Style="width:100%;">
                            <RadzenDropDown TValue="int?" Data="@carShows" TextProperty="Name" ValueProperty="ShowId" @bind-Value="templateShowId" AllowClear="true" Placeholder="Start without a template" Style="width:100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Event date" Variant="Variant.Outlined" Style="width:100%;">
                            <RadzenDatePicker @bind-Value="eventDate" Style="width:100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="End date" Variant="Variant.Outlined" Style="width:100%;">
                            <RadzenDatePicker @bind-Value="endDate" Style="width:100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenFormField Text="Location" Variant="Variant.Outlined" Style="width:100%;"><RadzenTextBox @bind-Value="location" Style="width:100%;" /></RadzenFormField>
                <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width:100%;"><RadzenTextArea @bind-Value="description" Style="width:100%;" /></RadzenFormField>
                <RadzenButton Text="Create Event" Icon="add" ButtonStyle="ButtonStyle.Primary" Disabled="@isBusy" Click="CreateEventAsync" />
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H5">Edit Existing Event</RadzenText>
                <RadzenFormField Text="Event to edit" Variant="Variant.Outlined" Style="width:100%;">
                    <RadzenDropDown TValue="int?" Data="@carShows" TextProperty="Name" ValueProperty="ShowId" Value="@editShowId" ValueChanged="SelectEventAsync" AllowClear="true" Placeholder="Select an event" Style="width:100%;" />
                </RadzenFormField>

                @if (editShowId.HasValue)
                {
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="Event name" Variant="Variant.Outlined" Style="width:100%;"><RadzenTextBox @bind-Value="editEventName" Style="width:100%;" /></RadzenFormField></RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="Location" Variant="Variant.Outlined" Style="width:100%;"><RadzenTextBox @bind-Value="editLocation" Style="width:100%;" /></RadzenFormField></RadzenColumn>
                    </RadzenRow>
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="Event date" Variant="Variant.Outlined" Style="width:100%;"><RadzenDatePicker @bind-Value="editEventDate" Style="width:100%;" /></RadzenFormField></RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="End date" Variant="Variant.Outlined" Style="width:100%;"><RadzenDatePicker @bind-Value="editEndDate" Style="width:100%;" /></RadzenFormField></RadzenColumn>
                    </RadzenRow>
                    <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width:100%;"><RadzenTextArea @bind-Value="editDescription" Style="width:100%;" /></RadzenFormField>
                    <RadzenButton Text="Update Event" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="@isBusy" Click="UpdateEventAsync" />

                    <RadzenText TextStyle="TextStyle.H6">Event Classes</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption">Classes such as Hot Rods, Classics, and Jeeps are available to registrants for this event.</RadzenText>
                    <RadzenRow Gap="1rem" AlignItems="AlignItems.End">
                        <RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="Class name" Variant="Variant.Outlined" Style="width:100%;"><RadzenTextBox @bind-Value="newClassName" Style="width:100%;" /></RadzenFormField></RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="5"><RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width:100%;"><RadzenTextBox @bind-Value="newClassDescription" Style="width:100%;" /></RadzenFormField></RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3"><RadzenButton Text="Add Class" Icon="add" ButtonStyle="ButtonStyle.Primary" Disabled="@isBusy" Click="CreateClassAsync" /></RadzenColumn>
                    </RadzenRow>
                    <RadzenDataGrid Data="@eventClasses" TItem="CarShowClassDto" EmptyText="No classes have been added for this event.">
                        <Columns>
                            <RadzenDataGridColumn TItem="CarShowClassDto" Title="Class Name">
                                <Template Context="item"><RadzenTextBox @bind-Value="item.ClassName" Style="width:100%;" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CarShowClassDto" Title="Description">
                                <Template Context="item"><RadzenTextBox @bind-Value="item.Description" Style="width:100%;" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CarShowClassDto" Title="Order" Width="110px">
                                <Template Context="item"><RadzenNumeric TValue="int?" @bind-Value="item.DisplayOrder" Style="width:100%;" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CarShowClassDto" Title="Active" Width="100px">
                                <Template Context="item"><RadzenCheckBox TValue="bool?" @bind-Value="item.Active" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CarShowClassDto" Title="Actions" Width="100px" Sortable="false" Filterable="false">
                                <Template Context="item"><RadzenButton Text="Save" Size="ButtonSize.Small" Disabled="@isBusy" Click="@(async _ => await UpdateClassAsync(item))" /></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
}

@code {
    private List<CarShowDto> carShows = [];
    private int? templateShowId;
    private string? eventName;
    private DateTime? eventDate = DateTime.Today;
    private DateTime? endDate;
    private string? location;
    private string? description;
    private int? editShowId;
    private string? editEventName;
    private DateTime? editEventDate;
    private DateTime? editEndDate;
    private string? editLocation;
    private string? editDescription;
    private List<CarShowClassDto> eventClasses = [];
    private string? newClassName;
    private string? newClassDescription;
    private string? errorMessage;
    private bool isBusy;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !UserSession.IsInitialized || !UserSession.CanManageUsers)
        {
            return;
        }

        try
        {
            carShows = (await Client.Api.CarShows.GetAsync() ?? []).Where(show => show.ShowId.HasValue).OrderByDescending(show => show.EventDate).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load existing car shows. {ex.Message}";
        }
    }

    private async Task SelectEventAsync(int? showId)
    {
        editShowId = showId;
        var show = carShows.FirstOrDefault(item => item.ShowId == showId);
        editEventName = show?.Name;
        editEventDate = show?.EventDate?.DateTime;
        editEndDate = show?.EndDate?.DateTime;
        editLocation = show?.Location;
        editDescription = show?.Description;

        eventClasses = [];
        if (!showId.HasValue)
        {
            return;
        }

        await LoadEventClassesAsync(showId.Value);
    }

    private async Task CreateClassAsync()
    {
        errorMessage = null;
        if (!editShowId.HasValue || string.IsNullOrWhiteSpace(newClassName))
        {
            errorMessage = "Class name is required.";
            return;
        }

        isBusy = true;
        try
        {
            await Client.Api.CarShowClasses.PostAsync(new CarShowClassDto
            {
                ShowId = editShowId.Value,
                ClassName = newClassName.Trim(),
                Description = string.IsNullOrWhiteSpace(newClassDescription) ? null : newClassDescription.Trim(),
                DisplayOrder = eventClasses.Count == 0 ? 1 : eventClasses.Max(item => item.DisplayOrder ?? 0) + 1,
                Active = true,
                CreatedByUserId = UserSession.CurrentUser?.UserId
            });
            newClassName = null;
            newClassDescription = null;
            await LoadEventClassesAsync(editShowId.Value);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to add the class. {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task UpdateClassAsync(CarShowClassDto item)
    {
        if (item.ClassId is not int classId || string.IsNullOrWhiteSpace(item.ClassName))
        {
            errorMessage = "Class name is required.";
            return;
        }

        isBusy = true;
        try
        {
            item.ClassName = item.ClassName.Trim();
            item.Description = string.IsNullOrWhiteSpace(item.Description) ? null : item.Description.Trim();
            await Client.Api.CarShowClasses[classId].PutAsync(item);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to update the class. {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadEventClassesAsync(int showId)
    {
        try
        {
            eventClasses = (await Client.Api.CarShowClasses.Show[showId].GetAsync() ?? [])
                .Where(item => item.ClassId.HasValue)
                .OrderBy(item => item.DisplayOrder)
                .ThenBy(item => item.ClassName)
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load event classes. {ex.Message}";
        }
    }

    private async Task UpdateEventAsync()
    {
        errorMessage = null;

        if (!editShowId.HasValue || string.IsNullOrWhiteSpace(editEventName) || !editEventDate.HasValue)
        {
            errorMessage = "Event name and event date are required.";
            return;
        }

        var show = carShows.FirstOrDefault(item => item.ShowId == editShowId.Value);
        if (show is null)
        {
            errorMessage = "The selected event could not be found.";
            return;
        }

        isBusy = true;
        try
        {
            show.Name = editEventName.Trim();
            show.EventDate = new DateTimeOffset(editEventDate.Value.Date);
            show.EndDate = editEndDate.HasValue ? new DateTimeOffset(editEndDate.Value.Date) : null;
            show.Location = string.IsNullOrWhiteSpace(editLocation) ? null : editLocation.Trim();
            show.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();

            await Client.Api.CarShows[editShowId.Value].PutAsync(show);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to update the event. {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task CopyConfigurationAsync(int templateShowId, int newShowId)
    {
        var questionIds = await CopyScoringQuestionsAsync(templateShowId, newShowId);
        await CopyClassesAsync(templateShowId, newShowId);
        var groupIds = new Dictionary<int, int>();
        var groups = await Client.Api.CarShowQuestionCalculationGroups.Show[templateShowId].GetAsync() ?? [];

        foreach (var group in groups.Where(group => group.QuestionCalculationGroupId.HasValue))
        {
            var created = await Client.Api.CarShowQuestionCalculationGroups.PostAsync(new CarShowQuestionCalculationGroupDto
            {
                ShowId = newShowId,
                GroupName = group.GroupName,
                OperationType = group.OperationType,
                SortOrder = group.SortOrder,
                Active = group.Active,
                CreatedByUserId = UserSession.CurrentUser?.UserId
            });
            if (created?.QuestionCalculationGroupId is not int newGroupId)
            {
                throw new InvalidOperationException("The API did not return an identifier for a copied calculation group.");
            }

            groupIds.Add(group.QuestionCalculationGroupId.Value, newGroupId);
            var members = await Client.Api.CarShowQuestionCalculationGroupQuestions.Group[group.QuestionCalculationGroupId.Value].GetAsync() ?? [];
            foreach (var member in members.Where(member => member.QuestionId.HasValue && questionIds.ContainsKey(member.QuestionId.Value)))
            {
                await Client.Api.CarShowQuestionCalculationGroupQuestions.PostAsync(new CarShowQuestionCalculationGroupQuestionDto
                {
                    QuestionCalculationGroupId = newGroupId,
                    QuestionId = questionIds[member.QuestionId.Value],
                    CalculationOrder = member.CalculationOrder,
                    CreatedByUserId = UserSession.CurrentUser?.UserId
                });
            }
        }

        var calculations = await Client.Api.CarShowGroupCalculations.Show[templateShowId].GetAsync() ?? [];
        foreach (var calculation in calculations.Where(calculation => calculation.GroupCalculationId.HasValue))
        {
            var created = await Client.Api.CarShowGroupCalculations.PostAsync(new CarShowGroupCalculationDto
            {
                ShowId = newShowId,
                CalculationName = calculation.CalculationName,
                OperationType = calculation.OperationType,
                SortOrder = calculation.SortOrder,
                Active = calculation.Active,
                CreatedByUserId = UserSession.CurrentUser?.UserId
            });
            if (created?.GroupCalculationId is not int newCalculationId)
            {
                throw new InvalidOperationException("The API did not return an identifier for a copied group calculation.");
            }

            var members = await Client.Api.CarShowGroupCalculationMembers.Group[calculation.GroupCalculationId.Value].GetAsync() ?? [];
            foreach (var member in members.Where(member => member.QuestionCalculationGroupId.HasValue && groupIds.ContainsKey(member.QuestionCalculationGroupId.Value)))
            {
                await Client.Api.CarShowGroupCalculationMembers.PostAsync(new CarShowGroupCalculationMemberDto
                {
                    GroupCalculationId = newCalculationId,
                    QuestionCalculationGroupId = groupIds[member.QuestionCalculationGroupId.Value],
                    CalculationOrder = member.CalculationOrder,
                    CreatedByUserId = UserSession.CurrentUser?.UserId
                });
            }
        }
    }

    private async Task<Dictionary<int, int>> CopyScoringQuestionsAsync(int templateShowId, int newShowId)
    {
        var questionIds = new Dictionary<int, int>();
        var questions = await Client.Api.CarShowScoringQuestions.Show[templateShowId].GetAsync() ?? [];

        foreach (var question in questions.Where(question => question.QuestionId.HasValue))
        {
            var created = await Client.Api.CarShowScoringQuestions.PostAsync(new CarShowScoringQuestionDto
            {
                ShowId = newShowId,
                QuestionText = question.QuestionText,
                Description = question.Description,
                Category = question.Category,
                AnswerType = question.AnswerType,
                MinScore = question.MinScore,
                MaxScore = question.MaxScore,
                Required = question.Required,
                Active = question.Active,
                SortOrder = question.SortOrder,
                JudgeNotes = question.JudgeNotes,
                CreatedByUserId = UserSession.CurrentUser?.UserId
            });

            if (created?.QuestionId is not int newQuestionId)
            {
                throw new InvalidOperationException("The API did not return an identifier for a copied scoring question.");
            }

            questionIds.Add(question.QuestionId.Value, newQuestionId);
        }

        return questionIds;
    }

    private async Task CopyClassesAsync(int templateShowId, int newShowId)
    {
        var classes = await Client.Api.CarShowClasses.Show[templateShowId].GetAsync() ?? [];
        foreach (var item in classes)
        {
            await Client.Api.CarShowClasses.PostAsync(new CarShowClassDto
            {
                ShowId = newShowId,
                ClassName = item.ClassName,
                Description = item.Description,
                CustomCriteria = item.CustomCriteria,
                DisplayOrder = item.DisplayOrder,
                ExpectedEntries = item.ExpectedEntries,
                MinYear = item.MinYear,
                MaxYear = item.MaxYear,
                OptionId = item.OptionId,
                TypeId = item.TypeId,
                Active = item.Active,
                CreatedByUserId = UserSession.CurrentUser?.UserId
            });
        }
    }

    private async Task CreateEventAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(eventName) || !eventDate.HasValue)
        {
            errorMessage = "Event name and event date are required.";
            return;
        }

        isBusy = true;
        try
        {
            var show = await Client.Api.CarShows.PostAsync(new CarShowDto
            {
                Name = eventName.Trim(),
                EventDate = new DateTimeOffset(eventDate.Value.Date),
                EndDate = endDate.HasValue ? new DateTimeOffset(endDate.Value.Date) : null,
                Location = string.IsNullOrWhiteSpace(location) ? null : location.Trim(),
                Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
                Active = true,
                CreatedByUserId = UserSession.CurrentUser?.UserId
            });

            if (show?.ShowId is not int showId)
            {
                errorMessage = "The event was created, but the API did not return its identifier.";
                return;
            }

            if (templateShowId.HasValue)
            {
                await CopyConfigurationAsync(templateShowId.Value, showId);
            }

            Navigation.NavigateTo($"/fetch-scoring?showId={showId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to create the event. {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
