@page "/fetch-carshows"
@rendermode InteractiveServer
@inject AcuCarShowClient Client
@inject DialogService DialogService
@inject UserSessionService UserSession

<PageTitle>Car Shows</PageTitle>

@if (!UserSession.IsAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">You must log in before viewing car shows.</RadzenAlert>
}
else if (!UserSession.CanRead)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">Your account does not have permission to view car shows.</RadzenAlert>
}
else
{
    <RadzenDialog />
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H4">Car Show Browser</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption">Acting user: @UserSession.EffectiveDisplayName</RadzenText>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success">@successMessage</RadzenAlert>
        }

        <RadzenRow AlignItems="AlignItems.End" Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                <RadzenFormField Text="Select Car Show" Variant="Variant.Outlined" Style="width:100%;">
                    <RadzenDropDown TValue="int?"
                                    Data="@carShows"
                                    TextProperty="Name"
                                    ValueProperty="ShowId"
                                    Value="@selectedShowId"
                                    ValueChanged="@OnShowSelectionChanged"
                                    AllowClear="true"
                                    Placeholder="Choose a show"
                                    Style="width:100%;" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
        }

        @if (isLoading)
        {
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
        }

        @if (selectedShow is not null)
        {
            <RadzenCard>
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H5">@selectedShow.Name</RadzenText>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="6"><b>Location:</b> @Display(selectedShow.Location)</RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="6"><b>Event Date:</b> @DisplayDate(selectedShow.EventDate)</RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6"><b>Total Participants:</b> @Display(selectedShow.TotalParticipants)</RadzenColumn>
                    </RadzenRow>
                    <RadzenText><b>Description:</b> @Display(selectedShow.Description)</RadzenText>
                </RadzenStack>
            </RadzenCard>

            @if (eventClasses.Count > 0)
            {
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenFormField Text="Filter by class" Variant="Variant.Outlined" Style="width:100%;">
                            <RadzenDropDown TValue="int?" Data="@eventClasses" TextProperty="ClassName" ValueProperty="ClassId" @bind-Value="selectedClassId" AllowClear="true" Placeholder="All classes" Style="width:100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            }

            <RadzenDataGrid Data="@FilteredResults" TItem="CarShowResult" AllowPaging="true" AllowSorting="true" PageSize="10" EmptyText="No entries found for this selection.">
                <Columns>
                    <RadzenDataGridColumn TItem="CarShowResult" Property="Owner" Title="Owner" />
                    <RadzenDataGridColumn TItem="CarShowResult" Property="CarType" Title="Car Type" />
                    <RadzenDataGridColumn TItem="CarShowResult" Property="ClassName" Title="Class" />
                    <RadzenDataGridColumn TItem="CarShowResult" Property="Placement" Title="Placement" />
                    <RadzenDataGridColumn TItem="CarShowResult" Property="FinalScore" Title="Final Score">
                        <Template Context="result">@(result.FinalScore?.ToString("0.##") ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CarShowResult" Property="EntryNumber" Title="#" Width="80px" />
                    <RadzenDataGridColumn TItem="CarShowResult" Title="Details" Sortable="false" Filterable="false" Width="110px">
                        <Template Context="result">
                            <RadzenButton Text="Details" Size="ButtonSize.Small" Click="@(async _ => await OpenDetails(result.Entry))" />
                        </Template>
                    </RadzenDataGridColumn>
                    @if (UserSession.IsAdmin)
                    {
                        <RadzenDataGridColumn TItem="CarShowResult" Title="Actions" Sortable="false" Filterable="false" Width="110px">
                            <Template Context="result">
                                <RadzenButton Text="Remove" Icon="delete_forever" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Disabled="isLoading" Click="@(() => DeleteEntryAsync(result.Entry))" />
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenStack>
}

@code {
    private List<CarShowDto> carShows = [];
    private List<CarShowEntryDto> entries = [];
    private List<CarShowResult> results = [];
    private List<CarShowClassDto> eventClasses = [];
    private Dictionary<int, CarShowFinalScoreDto> finalScoresByEntryId = [];
    private CarShowDto? selectedShow;
    private int? selectedShowId;
    private int? selectedClassId;
    private bool isLoading;
    private string? errorMessage;
    private string? successMessage;

    private IEnumerable<CarShowResult> FilteredResults => selectedClassId.HasValue
        ? results.Where(result => result.ClassId == selectedClassId.Value)
        : results;

    private string DisplayClass(int? classId) => eventClasses.FirstOrDefault(item => item.ClassId == classId)?.ClassName ?? "-";

    private static string DisplayCarType(CarDetailDto? carDetail)
    {
        var carType = string.Join(' ', new[] { carDetail?.Year?.ToString(), carDetail?.Make, carDetail?.Model }.Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(carType) ? "-" : carType;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !UserSession.IsInitialized || !UserSession.IsAuthenticated || !UserSession.CanRead)
        {
            return;
        }

        try
        {
            var response = await Client.Api.CarShows.GetAsync();
            carShows = response?.Where(x => x.ShowId.HasValue).ToList() ?? [];
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load car shows. {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnShowSelectionChanged(int? showId)
    {
        selectedShowId = showId;

        if (!selectedShowId.HasValue)
        {
            selectedShow = null;
            entries = [];
            results = [];
            eventClasses = [];
            finalScoresByEntryId = [];
            selectedClassId = null;
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var showTask = Client.Api.CarShows.Details[selectedShowId.Value].GetAsync();
            var entriesTask = LoadEntriesWithCarDetailsAsync(selectedShowId.Value);
            var classesTask = Client.Api.CarShowClasses.Show[selectedShowId.Value].GetAsync();
            var finalScoresTask = Client.Api.CarShowFinalScores.Show[selectedShowId.Value].GetAsync();
            await Task.WhenAll(showTask, entriesTask, classesTask, finalScoresTask);

            selectedShow = await showTask;
            entries = await entriesTask;
            eventClasses = (await classesTask ?? [])
                .Where(item => item.ClassId.HasValue)
                .OrderBy(item => item.DisplayOrder)
                .ThenBy(item => item.ClassName)
                .ToList();
            finalScoresByEntryId = (await finalScoresTask ?? [])
                .Where(item => item.EntryId.HasValue)
                .GroupBy(item => item.EntryId!.Value)
                .ToDictionary(group => group.Key, group => group.OrderByDescending(item => item.CalculatedDate).First());
            results = RebuildResults();
            selectedClassId = null;
        }
        catch (Exception ex)
        {
            selectedShow = null;
            entries = [];
            results = [];
            eventClasses = [];
            finalScoresByEntryId = [];
            errorMessage = $"Unable to load show details. {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<List<CarShowEntryDto>> LoadEntriesWithCarDetailsAsync(int showId)
    {
        var showEntries = (await Client.Api.CarShowEntries.Show[showId].GetAsync())?.ToList() ?? [];

        foreach (var entry in showEntries.Where(x => x.CarDetail is null && !string.IsNullOrWhiteSpace(x.Vin)))
        {
            try
            {
                entry.CarDetail = await Client.Api.CarDetails[entry.Vin!].GetAsync();
            }
            catch
            {
            }
        }

        return showEntries;
    }

    private async Task OpenDetails(CarShowEntryDto entry)
    {
        errorMessage = null;

        if (entry.CarDetail is null && !string.IsNullOrWhiteSpace(entry.Vin))
        {
            try
            {
                entry.CarDetail = await Client.Api.CarDetails[entry.Vin!].GetAsync();
            }
            catch (Exception ex)
            {
                errorMessage = $"Unable to load full details for VIN {entry.Vin}. Showing available data. {ex.Message}";
            }
        }

        var detail = entry.CarDetail ?? new CarDetailDto
        {
            Vin = entry.Vin,
            Status = entry.Status
        };

        var result = await DialogService.OpenAsync<ModalCarDetail>(
            $"{Display(detail.Year)} {Display(detail.Make)} {Display(detail.Model)}",
            new Dictionary<string, object?>
            {
                { nameof(ModalCarDetail.CarDetail), detail },
                { nameof(ModalCarDetail.EntryNumber), entry.EntryNumber },
                { nameof(ModalCarDetail.CanEditEntryNumber), UserSession.CanWrite }
            },
            new DialogOptions
            {
                Width = "700px",
                CloseDialogOnEsc = true,
                CloseDialogOnOverlayClick = true,
                Resizable = true,
                Draggable = true
            });

        if (UserSession.CanWrite
            && result is ModalCarDetail.EntryNumberUpdateResult update
            && update.EntryNumber != entry.EntryNumber)
        {
            await UpdateEntryNumberAsync(entry, update.EntryNumber);
        }
    }

    private async Task UpdateEntryNumberAsync(CarShowEntryDto entry, int? newEntryNumber)
    {
        if (!entry.EntryId.HasValue)
        {
            errorMessage = "Unable to update entry number because entry id is missing.";
            return;
        }

        errorMessage = null;
        successMessage = null;

        var previousEntryNumber = entry.EntryNumber;
        entry.EntryNumber = newEntryNumber;

        try
        {
            await Client.Api.CarShowEntries[entry.EntryId.Value].PutAsync(CreateEntryUpdatePayload(entry));
            successMessage = $"Entry number updated for entry #{entry.EntryNumber ?? entry.EntryId}.";
            results = RebuildResults();
        }
        catch (Exception ex)
        {
            entry.EntryNumber = previousEntryNumber;
            errorMessage = $"Unable to update entry number for entry #{previousEntryNumber ?? entry.EntryId}. {ex.Message}";
        }
    }

    private async Task DeleteEntryAsync(CarShowEntryDto entry)
    {
        if (!UserSession.IsAdmin)
        {
            errorMessage = "Only administrators can remove entries.";
            return;
        }

        if (entry.EntryId is not int entryId)
        {
            errorMessage = "Unable to remove this entry because its entry id is missing.";
            return;
        }

        var entryLabel = entry.EntryNumber?.ToString() ?? entryId.ToString();
        var confirmed = await DialogService.Confirm(
            $"Permanently remove entry #{entryLabel}? This cannot be undone.",
            "Remove Entry",
            new ConfirmOptions
            {
                OkButtonText = "Remove",
                CancelButtonText = "Cancel"
            });

        if (confirmed != true)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            await Client.Api.CarShowEntries[entryId].DeleteAsync();
            entries.RemoveAll(item => item.EntryId == entryId);
            finalScoresByEntryId.Remove(entryId);
            results = RebuildResults();
            successMessage = $"Entry #{entryLabel} was removed.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to remove entry #{entryLabel}. {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static CarShowEntryDto CreateEntryUpdatePayload(CarShowEntryDto entry)
    {
        return new CarShowEntryDto
        {
            Category = entry.Category,
            ClassId = entry.ClassId,
            EntryId = entry.EntryId,
            EntryNumber = entry.EntryNumber,
            JudgeScore = entry.JudgeScore,
            Notes = entry.Notes,
            PaidAmount = entry.PaidAmount,
            PaidAtUtc = entry.PaidAtUtc,
            PaidByUserId = entry.PaidByUserId,
            PaymentProofReference = entry.PaymentProofReference,
            PaymentProvider = entry.PaymentProvider,
            PaymentProviderIntentId = entry.PaymentProviderIntentId,
            PaymentProviderSessionId = entry.PaymentProviderSessionId,
            PaymentStatus = entry.PaymentStatus,
            PaymentTiming = entry.PaymentTiming,
            Placement = entry.Placement,
            PreferredPaymentMethod = entry.PreferredPaymentMethod,
            RegistrationDate = entry.RegistrationDate,
            ShowId = entry.ShowId,
            Status = entry.Status,
            SubmittedByUserId = entry.SubmittedByUserId,
            Vin = entry.Vin
        };
    }

    private List<CarShowResult> RebuildResults()
    {
        return entries.Select(entry => new CarShowResult(
            entry,
            entry.CarDetail?.Owner ?? "-",
            DisplayCarType(entry.CarDetail),
            DisplayClass(entry.ClassId),
            entry.Placement ?? "-",
            entry.EntryId.HasValue && finalScoresByEntryId.TryGetValue(entry.EntryId.Value, out var score) ? score.Score : null,
            entry.EntryNumber,
            entry.ClassId)).ToList();
    }

    private async Task OpenManualPaymentDialogAsync(CarShowEntryDto entry)
    {
        if (!entry.EntryId.HasValue)
        {
            errorMessage = "Unable to update payment because entry id is missing.";
            return;
        }

        errorMessage = null;
        successMessage = null;

        CarShowEntryPaymentDto? paymentDetails;
        try
        {
            paymentDetails = await Client.Api.CarShowEntries[entry.EntryId.Value].Payment.GetAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load current payment details for entry #{entry.EntryNumber ?? entry.EntryId}. {ex.Message}";
            return;
        }

        var result = await DialogService.OpenAsync<ManualPaymentDialog>(
            "Manual Payment Update",
            new Dictionary<string, object?>
            {
                { nameof(ManualPaymentDialog.Entry), entry },
                { nameof(ManualPaymentDialog.Payment), paymentDetails }
            },
            new DialogOptions
            {
                Width = "640px",
                CloseDialogOnEsc = true,
                CloseDialogOnOverlayClick = false
            });

        if (result is not CarShowEntryManualPaymentUpdateDto update)
        {
            return;
        }

        try
        {
            var updated = await Client.Api.CarShowEntries[entry.EntryId.Value].Payment.Manual.PutAsync(update);

            if (updated is not null)
            {
                entry.PaymentStatus = updated.PaymentStatus;
                entry.PaymentTiming = updated.PaymentTiming;
                entry.PreferredPaymentMethod = updated.PreferredPaymentMethod;
                entry.PaymentProofReference = updated.PaymentProofReference;
                entry.PaidAmount = updated.PaidAmount;
                entry.PaidAtUtc = updated.PaidAtUtc;
                entry.PaidByUserId = updated.PaidByUserId;
                entry.PaymentProvider = updated.PaymentProvider;
                entry.PaymentProviderSessionId = updated.PaymentProviderSessionId;
                entry.PaymentProviderIntentId = updated.PaymentProviderIntentId;
            }

            successMessage = $"Payment updated for entry #{entry.EntryNumber ?? entry.EntryId}.";
        }
        catch (Exception ex)
        {
            if (IsConcurrencyConflict(ex))
            {
                await RefreshEntryPaymentSnapshotAsync(entry);
                errorMessage = $"Payment update conflict detected for entry #{entry.EntryNumber ?? entry.EntryId}. The record was updated by another user. Latest payment data has been reloaded. Please review and submit again.";
                return;
            }

            errorMessage = $"Unable to update payment for entry #{entry.EntryNumber ?? entry.EntryId}. {ex.Message}";
        }
    }

    private async Task RefreshEntryPaymentSnapshotAsync(CarShowEntryDto entry)
    {
        if (!entry.EntryId.HasValue)
        {
            return;
        }

        try
        {
            var refreshed = await Client.Api.CarShowEntries[entry.EntryId.Value].Payment.GetAsync();
            if (refreshed is null)
            {
                return;
            }

            entry.PaymentStatus = refreshed.PaymentStatus;
            entry.PaymentTiming = refreshed.PaymentTiming;
            entry.PreferredPaymentMethod = refreshed.PreferredPaymentMethod;
            entry.PaymentProofReference = refreshed.PaymentProofReference;
            entry.PaidAmount = refreshed.PaidAmount;
            entry.PaidAtUtc = refreshed.PaidAtUtc;
            entry.PaidByUserId = refreshed.PaidByUserId;
            entry.PaymentProvider = refreshed.PaymentProvider;
            entry.PaymentProviderSessionId = refreshed.PaymentProviderSessionId;
            entry.PaymentProviderIntentId = refreshed.PaymentProviderIntentId;
        }
        catch
        {
        }
    }

    private static bool IsConcurrencyConflict(Exception ex)
    {
        if (string.IsNullOrWhiteSpace(ex.Message))
        {
            return false;
        }

        return ex.Message.Contains("409", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("concurrency", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("rowversion", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("row version", StringComparison.OrdinalIgnoreCase);
    }

    private sealed record CarShowResult(
        CarShowEntryDto Entry,
        string Owner,
        string CarType,
        string ClassName,
        string Placement,
        double? FinalScore,
        int? EntryNumber,
        int? ClassId);

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string Display(int? value)
    {
        return value?.ToString() ?? "-";
    }

    private static string DisplayDate(DateTimeOffset? value)
    {
        return value?.ToString("MMM dd, yyyy") ?? "-";
    }
}
