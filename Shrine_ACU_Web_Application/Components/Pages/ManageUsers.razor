@page "/manage-users"
@rendermode InteractiveServer

@inject AcuCarShowClient Client
@inject UserRolesApiClient UserRolesApi
@inject UserEventRolesApiClient UserEventRolesApi
@inject AttendanceEventsApiClient AttendanceEventsApi
@inject UserSessionService UserSession
@inject DialogService DialogService
@inject IWebHostEnvironment Environment
@implements IDisposable

<PageTitle>Manage Users</PageTitle>

@if (!UserSession.IsAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">You must log in to manage users.</RadzenAlert>
}
else if (!UserSession.CanManageUsers)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">Your account does not have permission to manage users.</RadzenAlert>
}
else
{
    <RadzenStack Gap="1rem">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenText TextStyle="TextStyle.H4">Manage Users</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">Assign each user's role and permissions within the appropriate application.</RadzenText>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Disabled="isBusy" Click="LoadUsersAsync" />
            </RadzenColumn>
        </RadzenRow>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success">@successMessage</RadzenAlert>
        }

        @if (isBusy)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
                <RadzenText TextStyle="TextStyle.Body2">Loading users...</RadzenText>
            </RadzenStack>
        }
        else
        {
            @if (selectedUser is not null)
            {
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenColumn>
                                <RadzenText TextStyle="TextStyle.H6">Role Access: @GetDisplayName(selectedUser)</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2">Roles can be assigned by application and by attendance event.</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenButton Text="Close" Icon="close" ButtonStyle="ButtonStyle.Light" Click="CloseRoleEditor" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Application" Variant="Variant.Outlined" Style="width:100%;">
                                    <RadzenDropDown TValue="int?" Data="@applications" TextProperty="Name" ValueProperty="ApplicationId" @bind-Value="selectedApplicationId" Change="LoadSelectedRoleContextAsync" Style="width:100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Role" Variant="Variant.Outlined" Style="width:100%;">
                                    <RadzenDropDown TValue="UserAccessRole" Data="@assignableRoles" @bind-Value="roleEditor.AccessRoles" Style="width:100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="padding-top:1rem;">
                                    <RadzenCheckBox TValue="bool" @bind-Value="roleEditor.CanRead" Name="roleCanRead" /><label for="roleCanRead">Read</label>
                                    <RadzenCheckBox TValue="bool" @bind-Value="roleEditor.CanWrite" Name="roleCanWrite" /><label for="roleCanWrite">Write</label>
                                    <RadzenCheckBox TValue="bool" @bind-Value="roleEditor.CanManage" Name="roleCanManage" /><label for="roleCanManage">Manage</label>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenButton Text="Save Application Role" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="@(isBusy || !selectedApplicationId.HasValue)" Click="SaveRoleContextAsync" />

                        <RadzenDivider />

                        <RadzenText TextStyle="TextStyle.H6">Attendance Event Role</RadzenText>
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Attendance Event" Variant="Variant.Outlined" Style="width:100%;">
                                    <RadzenDropDown TValue="int?" Data="@attendanceEvents" TextProperty="Name" ValueProperty="EventId" @bind-Value="selectedAttendanceEventId" Change="LoadSelectedEventRoleContextAsync" Style="width:100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Event Role" Variant="Variant.Outlined" Style="width:100%;">
                                    <RadzenDropDown TValue="UserAccessRole" Data="@assignableRoles" @bind-Value="eventRoleEditor.AccessRoles" Style="width:100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="padding-top:1rem;">
                                    <RadzenCheckBox TValue="bool" @bind-Value="eventRoleEditor.CanRead" Name="eventRoleCanRead" /><label for="eventRoleCanRead">Read</label>
                                    <RadzenCheckBox TValue="bool" @bind-Value="eventRoleEditor.CanWrite" Name="eventRoleCanWrite" /><label for="eventRoleCanWrite">Write</label>
                                    <RadzenCheckBox TValue="bool" @bind-Value="eventRoleEditor.CanManage" Name="eventRoleCanManage" /><label for="eventRoleCanManage">Manage</label>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenButton Text="Save Event Role" Icon="event_available" ButtonStyle="ButtonStyle.Secondary" Disabled="@(isBusy || !selectedAttendanceEventId.HasValue)" Click="SaveEventRoleContextAsync" />
                    </RadzenStack>
                </RadzenCard>
            }
            <RadzenDataGrid Data="@users"
                            TItem="AppUserDto"
                            AllowFiltering="true"
                            FilterMode="FilterMode.Simple"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            AllowSorting="true"
                            AllowVirtualization="true"
                            AllowPaging="false"
                            Style="height:calc(100vh - 250px);min-height:420px;"
                            EmptyText="No users were found.">
                <Columns>
                    <RadzenDataGridColumn TItem="AppUserDto" Property="DisplayName" Title="Name">
                        <Template Context="user">@GetDisplayName(user)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AppUserDto" Property="Username" Title="Username" />
                    <RadzenDataGridColumn TItem="AppUserDto" Property="Email" Title="Email" />
                    <RadzenDataGridColumn TItem="AppUserDto" Title="Roles">
                        <Template Context="user">
                            <RadzenBadge Text="@(IsJudge(user) ? "Includes Judge" : "No Judge role")" BadgeStyle="@(IsJudge(user) ? BadgeStyle.Info : BadgeStyle.Light)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AppUserDto" Title="Actions" Sortable="false" Filterable="false">
                        <Template Context="user">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton Text="Manage Roles" Icon="admin_panel_settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Disabled="isBusy" Click="@(() => OpenRoleEditorAsync(user))" />
                                <RadzenButton Text="Delete" Icon="delete_forever" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Disabled="@(isBusy || user.UserId == UserSession.CurrentUser?.UserId)" Click="@(() => DeleteUserAsync(user))" />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenStack>
}

@code {
    private List<AppUserDto> users = [];
    private List<ApplicationDto> applications = [];
    private List<AttendanceEventDto> attendanceEvents = [];
    private readonly UserAccessRole[] assignableRoles = [UserAccessRole.None, UserAccessRole.Participant, UserAccessRole.Judge, UserAccessRole.Manager, UserAccessRole.Admin];
    private AppUserDto? selectedUser;
    private int? selectedApplicationId;
    private int? selectedAttendanceEventId;
    private UserRoleUpsertRequestDto roleEditor = new();
    private UserEventRoleUpsertRequestDto eventRoleEditor = new();
    private bool isBusy;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        UserSession.StateChanged += HandleUserSessionChanged;

        if (UserSession.IsAuthenticated && UserSession.CanManageUsers)
        {
            await LoadUsersAsync();
        }
    }

    private void HandleUserSessionChanged()
    {
        if (!UserSession.IsAuthenticated || !UserSession.CanManageUsers || users.Count > 0 || isBusy)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadUsersAsync();
            StateHasChanged();
        });
    }

    private async Task LoadUsersAsync()
    {
        ResetMessages();
        isBusy = true;

        try
        {
            users = (await Client.Api.AppUsers.GetAsync() ?? []).OrderBy(GetDisplayName).ToList();
            applications = (await Client.Api.Applications.GetAsync() ?? [])
                .Where(application => application.ApplicationId.HasValue && application.Active != false)
                .OrderBy(application => application.Name)
                .ToList();

            attendanceEvents = (await AttendanceEventsApi.GetAllAsync())
                .Where(eventRow => eventRow.EventId.HasValue)
                .OrderByDescending(eventRow => eventRow.EventDates.OrderByDescending(dateRow => dateRow.EventDate).FirstOrDefault()?.EventDate)
                .ThenBy(eventRow => eventRow.Name)
                .ToList();

            foreach (var user in users.Where(user => user.UserId.HasValue))
            {
                user.ApplicationAccesses = await Client.Api.UserApplicationAccess.User[user.UserId!.Value].GetAsync() ?? [];
            }

        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to load users.", ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OpenRoleEditorAsync(AppUserDto user)
    {
        selectedUser = user;
        selectedApplicationId = applications.FirstOrDefault(application =>
            application.Name?.Contains("attendance", StringComparison.OrdinalIgnoreCase) == true)?.ApplicationId
            ?? applications.FirstOrDefault()?.ApplicationId;
        selectedAttendanceEventId = attendanceEvents.FirstOrDefault()?.EventId;

        await LoadSelectedRoleContextAsync();
        await LoadSelectedEventRoleContextAsync();
    }

    private void CloseRoleEditor()
    {
        selectedUser = null;
        selectedApplicationId = null;
        selectedAttendanceEventId = null;
        roleEditor = new();
        eventRoleEditor = new();
    }

    private async Task LoadSelectedRoleContextAsync()
    {
        if (selectedUser?.UserId is not int userId || selectedApplicationId is not int applicationId)
        {
            roleEditor = new();
            return;
        }

        try
        {
            var context = await UserRolesApi.GetContextAsync(userId, applicationId);
            roleEditor = new UserRoleUpsertRequestDto
            {
                AccessRoles = context?.AccessRoles ?? UserAccessRole.None,
                CanRead = context?.CanRead ?? false,
                CanWrite = context?.CanWrite ?? false,
                CanManage = context?.CanManage ?? false
            };
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to load the selected role context.", ex);
        }
    }

    private async Task SaveRoleContextAsync()
    {
        if (selectedUser?.UserId is not int userId || selectedApplicationId is not int applicationId)
        {
            return;
        }

        ResetMessages();
        isBusy = true;
        try
        {
            await UserRolesApi.UpsertContextAsync(userId, applicationId, roleEditor);
            successMessage = $"Application role access was updated for {GetDisplayName(selectedUser)}.";
            await LoadUsersAsync();

            if (userId == UserSession.CurrentUser?.UserId)
            {
                await UserSession.RefreshCurrentUserAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to save role access.", ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadSelectedEventRoleContextAsync()
    {
        if (selectedUser?.UserId is not int userId || selectedAttendanceEventId is not int eventId)
        {
            eventRoleEditor = new();
            return;
        }

        try
        {
            var context = await UserEventRolesApi.GetContextAsync(userId, eventId);
            eventRoleEditor = new UserEventRoleUpsertRequestDto
            {
                AccessRoles = context?.AccessRoles ?? UserAccessRole.None,
                CanRead = context?.CanRead ?? false,
                CanWrite = context?.CanWrite ?? false,
                CanManage = context?.CanManage ?? false
            };
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to load the selected event role context.", ex);
        }
    }

    private async Task SaveEventRoleContextAsync()
    {
        if (selectedUser?.UserId is not int userId || selectedAttendanceEventId is not int eventId)
        {
            return;
        }

        ResetMessages();
        isBusy = true;
        try
        {
            await UserEventRolesApi.UpsertContextAsync(userId, eventId, eventRoleEditor);
            successMessage = $"Attendance event role access was updated for {GetDisplayName(selectedUser)}.";

            if (userId == UserSession.CurrentUser?.UserId)
            {
                await UserSession.RefreshCurrentUserAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to save event role access.", ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    private static bool IsJudge(AppUserDto user) =>
        user.ApplicationAccesses?.Any(access => access.AccessRoles.HasValue && access.AccessRoles.Value.HasFlag(UserAccessRole.Judge)) == true;

    private static string GetDisplayName(AppUserDto user)
    {
        if (!string.IsNullOrWhiteSpace(user.DisplayName))
        {
            return user.DisplayName;
        }

        var name = string.Join(' ', new[] { user.FirstName, user.LastName }.Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(name) ? user.Username ?? "Unknown user" : name;
    }

    private string BuildErrorMessage(string message, Exception exception)
    {
        if (Environment.IsDevelopment())
        {
            return $"{message} {exception.Message}";
        }

        if (exception is Microsoft.Kiota.Abstractions.ApiException apiException)
        {
            return $"{message} (HTTP {apiException.ResponseStatusCode})";
        }

        return message;
    }

    private void ResetMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    public void Dispose()
    {
        UserSession.StateChanged -= HandleUserSessionChanged;
    }

    private async Task ToggleJudgeAsync(AppUserDto user)
    {
        if (user.UserId is not int userId)
        {
            errorMessage = "The selected user does not have a valid identifier.";
            return;
        }

        ResetMessages();
        isBusy = true;

        try
        {
            var accesses = user.ApplicationAccesses ?? [];
            var judgeAccess = accesses.FirstOrDefault(access =>
                access.AccessRoles.HasValue && access.AccessRoles.Value.HasFlag(UserAccessRole.Judge));

            if (judgeAccess is null)
            {
                var existingAccess = accesses.FirstOrDefault(access => access.UserApplicationAccessId.HasValue);

                if (existingAccess?.UserApplicationAccessId is int accessId)
                {
                    existingAccess.AccessRoles = (existingAccess.AccessRoles ?? UserAccessRole.None) | UserAccessRole.Judge;
                    existingAccess.CanRead = true;
                    existingAccess.CanWrite = true;
                    await Client.Api.UserApplicationAccess[accessId].PutAsync(existingAccess);
                }
                else
                {
                    var applicationId = await ResolveApplicationIdAsync();

                    if (applicationId is null)
                    {
                        errorMessage = "Unable to determine the application to grant judge access for.";
                        return;
                    }

                    await Client.Api.UserApplicationAccess.PostAsync(new UserApplicationAccessDto
                    {
                        UserId = userId,
                        ApplicationId = applicationId,
                        AccessRoles = UserAccessRole.Judge,
                        CanRead = true,
                        CanWrite = true,
                        CanManage = false,
                        GrantedDate = DateTimeOffset.UtcNow
                    });
                }

                if (!await VerifyJudgeAccessAsync(userId))
                {
                    errorMessage = $"The server accepted the request, but {GetDisplayName(user)} still has no judge access. The API did not save the change.";
                    await TryReloadUsersAsync();
                    return;
                }

                successMessage = $"{GetDisplayName(user)} can now score entries as a judge.";
            }
            else if (judgeAccess.UserApplicationAccessId is int judgeAccessId)
            {
                var remainingRoles = judgeAccess.AccessRoles!.Value & ~UserAccessRole.Judge;

                if (remainingRoles == UserAccessRole.None)
                {
                    await Client.Api.UserApplicationAccess[judgeAccessId].DeleteAsync();
                }
                else
                {
                    judgeAccess.AccessRoles = remainingRoles;
                    await Client.Api.UserApplicationAccess[judgeAccessId].PutAsync(judgeAccess);
                }

                successMessage = $"Judge access was removed from {GetDisplayName(user)}.";
            }

            await TryReloadUsersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to update judge access.", ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    // The API can acknowledge a POST/PUT without persisting the change, so confirm the
    // judge role is actually stored before reporting success to the operator.
    private async Task<bool> VerifyJudgeAccessAsync(int userId)
    {
        var savedAccesses = await Client.Api.UserApplicationAccess.User[userId].GetAsync() ?? [];
        return savedAccesses.Any(access =>
            access.AccessRoles.HasValue && access.AccessRoles.Value.HasFlag(UserAccessRole.Judge));
    }

    private async Task TryReloadUsersAsync()
    {
        try
        {
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            errorMessage ??= BuildErrorMessage("The change was saved, but the user list could not be refreshed.", ex);
        }
    }

    // This application currently manages access for a single Application record, so any known
    // ApplicationId (from an existing access) or the sole/active Application returned by the API
    // is a safe choice when creating a brand-new access record.
    private async Task<int?> ResolveApplicationIdAsync()
    {
        var knownApplicationId = users
            .SelectMany(user => user.ApplicationAccesses ?? [])
            .Select(access => access.ApplicationId)
            .FirstOrDefault(applicationId => applicationId.HasValue);

        if (knownApplicationId.HasValue)
        {
            return knownApplicationId;
        }

        try
        {
            var applications = await Client.Api.Applications.GetAsync() ?? [];
            return applications.FirstOrDefault(application => application.Active != false)?.ApplicationId
                ?? applications.FirstOrDefault()?.ApplicationId;
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to determine the application to grant judge access for.", ex);
            return null;
        }
    }

    private async Task DeleteUserAsync(AppUserDto user)
    {
        if (user.UserId is not int userId || userId == UserSession.CurrentUser?.UserId)
        {
            errorMessage = "You cannot delete the account currently being used.";
            return;
        }

        var confirmed = await DialogService.Confirm(
            $"Permanently delete {GetDisplayName(user)}? This cannot be undone.",
            "Delete User",
            new ConfirmOptions
            {
                OkButtonText = "Delete",
                CancelButtonText = "Cancel"
            });

        if (confirmed != true)
        {
            return;
        }

        ResetMessages();
        isBusy = true;

        try
        {
            await Client.Api.AppUsers[userId].DeleteAsync();
            successMessage = $"{GetDisplayName(user)} was permanently deleted.";
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = BuildErrorMessage("Unable to delete the user.", ex);
        }
        finally
        {
            isBusy = false;
        }
    }
}
