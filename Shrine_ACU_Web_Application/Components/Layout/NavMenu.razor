@inject UserSessionService UserSession
@inject NavigationManager Navigation
@implements IDisposable

<div class="main-nav">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <NavLink class="navbar-brand" href="" Match="NavLinkMatch.All">
                <img class="navbar-logo" src="/Icons/png_shrine_logo_transparent.png" alt="Shrine logo" />
            </NavLink>

            <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

            <div class="nav-scrollable">
                <nav class="nav">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                        </NavLink>
                    </div>

                    <details class="nav-item nav-module-dropdown px-3">
                        <summary class="@GetModuleSummaryCss("attendance/sign-in", "manage-attendance")">Attendance</summary>
                        <div class="module-dropdown-menu">
                            <NavLink class="nav-link module-link" href="attendance/sign-in">Attendance Sign-In</NavLink>
                            @if (UserSession.CanManageAttendance)
                            {
                                <NavLink class="nav-link module-link" href="manage-attendance">Manage Attendance</NavLink>
                            }
                        </div>
                    </details>

                    @if (!UserSession.IsAuthenticated)
                    {
                        <details class="nav-item nav-module-dropdown px-3">
                            <summary class="@GetModuleSummaryCss("fetch-login", "fetch-register")">Account</summary>
                            <div class="module-dropdown-menu">
                                <NavLink class="nav-link module-link" href="fetch-login">Login</NavLink>
                                <NavLink class="nav-link module-link" href="fetch-register">Create Account</NavLink>
                            </div>
                        </details>
                    }
                    else
                    {
                        @if (UserSession.CanRead || UserSession.CanWrite || UserSession.CanManageCarShows || UserSession.CanAccessScoringApplication)
                        {
                            <details class="nav-item nav-module-dropdown px-3">
                                <summary class="@GetModuleSummaryCss("fetch-carshows", "fetch-signup", "manage-carshows", "fetch-scoring")">Events</summary>
                                <div class="module-dropdown-menu">
                                    @if (UserSession.CanRead)
                                    {
                                        <NavLink class="nav-link module-link" href="fetch-carshows">Car Shows</NavLink>
                                    }
                                    @if (UserSession.CanWrite)
                                    {
                                        <NavLink class="nav-link module-link" href="fetch-signup">Signup</NavLink>
                                    }
                                    @if (UserSession.CanManageCarShows)
                                    {
                                        <NavLink class="nav-link module-link" href="manage-carshows">Manage Events</NavLink>
                                    }
                                    @if (UserSession.CanAccessScoringApplication)
                                    {
                                        <NavLink class="nav-link module-link" href="fetch-scoring">Scoring</NavLink>
                                    }
                                </div>
                            </details>
                        }

                        @if (UserSession.CanManage || UserSession.CanManageUsers)
                        {
                            <details class="nav-item nav-module-dropdown px-3">
                                <summary class="@GetModuleSummaryCss("fetch-payments", "manage-users")">Administration</summary>
                                <div class="module-dropdown-menu">
                                    @if (UserSession.CanManage)
                                    {
                                        <NavLink class="nav-link module-link" href="fetch-payments">Payments</NavLink>
                                    }
                                    @if (UserSession.CanManageUsers)
                                    {
                                        <NavLink class="nav-link module-link" href="manage-users">Manage Users</NavLink>
                                    }
                                </div>
                            </details>
                        }
                    }
                </nav>

                <div class="navbar-extras">
                    <a class="about-link" href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>

                    @if (UserSession.IsAuthenticated)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            @if (UserSession.CanManageUsers)
                            {
                                <RadzenDropDown TValue="int?"
                                                Data="@UserSession.AvailableUsers"
                                                TextProperty="DisplayName"
                                                ValueProperty="UserId"
                                                Value="@UserSession.EffectiveUserId"
                                                Change="OnEffectiveUserChanged"
                                                Style="min-width:180px;"
                                                Placeholder="Acting user" />
                            }
                            <RadzenButton Text="@DisplayUser(UserSession.CurrentUser)" Icon="person" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="NavigateToProfile" />
                            <RadzenButton Text="Logout" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Click="LogoutAsync" />
                        </RadzenStack>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        UserSession.StateChanged += HandleSessionChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void OnEffectiveUserChanged(object? value)
    {
        UserSession.SetEffectiveUser(value as int?);
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/profile");
    }

    private async Task LogoutAsync()
    {
        await UserSession.LogoutAsync();
        Navigation.NavigateTo("/fetch-login", forceLoad: false);
    }

    private string GetModuleSummaryCss(params string[] routePrefixes)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        var isActive = routePrefixes.Any(prefix => currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
        return isActive ? "module-summary nav-link active" : "module-summary nav-link";
    }

    private static string DisplayUser(AppUserDto? user)
    {
        if (!string.IsNullOrWhiteSpace(user?.DisplayName))
        {
            return user!.DisplayName!;
        }

        var fullName = string.Join(' ', new[] { user?.FirstName, user?.LastName }.Where(x => !string.IsNullOrWhiteSpace(x))).Trim();
        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName;
        }

        return user?.Username ?? "-";
    }

    private void HandleSessionChanged() => InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        UserSession.StateChanged -= HandleSessionChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}

